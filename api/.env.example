# Origen permitido por CORS para el frontend Vite
WEB_ORIGIN=http://127.0.0.1:5173

# Almacenamiento de videos (MP4, WebM y MOV)
VIDEO_UPLOAD_DIR=uploads/videos
VIDEO_MAX_SIZE_MB=100
