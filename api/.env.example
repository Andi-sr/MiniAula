PORT=el_puerto_aqui
NODE_ENV=el_entorno_aqui

DB_HOST=el_host_aqui
DB_PORT=el_puerto_aqui
DB_NAME=el_nombre_de_la_base_de_datos_aqui
DB_USER=el_usuario_aqui
DB_PASSWORD=la_contraseña_aqui

JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO
